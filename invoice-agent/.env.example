# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini          # or gpt-4o for higher accuracy

# ── Slack ────────────────────────────────────────────────────────────────────
# Leave blank to disable Slack — agent will print to console instead
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── QuickBooks Online ─────────────────────────────────────────────────────────
# Leave blank to skip QB bill creation (uses stub mode)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=

# ── Notion (optional future integration) ─────────────────────────────────────
NOTION_API_KEY=
NOTION_DB_ID=
